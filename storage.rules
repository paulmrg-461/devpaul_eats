rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    // ---- Helpers ----
    function isSignedIn() {
      return request.auth != null;
    }

    // Valid image upload: image content-type, under 5 MB.
    function isValidImage() {
      return request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    // True if signed-in user owns the vendor document `vendorId`.
    function isVendorOwner(vendorId) {
      return isSignedIn()
        && firestore.get(/databases/(default)/documents/vendors/$(vendorId)).data.userId
           == request.auth.uid;
    }

    // Vendor cover photos: vendors/<userId>/cover_<ts>.jpg
    match /vendors/{userId}/{fileName} {
      allow read: if isSignedIn();
      allow write: if request.auth != null
        && request.auth.uid == userId
        && isValidImage();
    }

    // Menu item images: menu_items/<vendorId>/<ts>.jpg
    match /menu_items/{vendorId}/{fileName} {
      allow read: if isSignedIn();
      allow write: if isVendorOwner(vendorId) && isValidImage();
    }
  }
}
